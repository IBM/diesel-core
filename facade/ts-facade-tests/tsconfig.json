{
  "include": ["src"],
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "mocha"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "compileOnSave": true,
  "exclude": ["node_modules", "dist"]
}
